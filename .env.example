# Pakdam environment variables.
# PLACEHOLDER VALUES ONLY — never put a real key in this file.
# Copy to .env.local and fill in real values from the Vercel / Cloudflare /
# Supabase dashboards. .env.local is git-ignored and must never be committed.

# --- Public (build-time, baked into the web bundle) -------------------------
# Supabase project URL (Mumbai project). Public value.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
# Supabase anon (publishable) key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
# Cloudflare Worker base URL, e.g. https://pakdam.<subdomain>.workers.dev
# Leave empty for local demo mode (no live transport).
NEXT_PUBLIC_WORKER_URL=
# Public site URL, e.g. https://pakdam.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ola Maps API key for the dark vector style (default-dark-standard).
NEXT_PUBLIC_OLA_MAPS_API_KEY=placeholder-ola-maps-api-key

# --- Server-only (Worker bindings — never NEXT_PUBLIC_*) --------------------
# Supabase project URL, plain [vars] value in wrangler.toml (public value).
SUPABASE_URL=https://placeholder.supabase.co
# Supabase service-role key — a Cloudflare secret (wrangler secret put).
# NEVER commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
